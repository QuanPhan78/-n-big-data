# ==========================================
# NYC Taxi Big Data - Environment Variables
# Copy to .env and adjust as needed
# ==========================================

# Data storage paths
NYC_DATA_ROOT=./data
HDFS_NAMENODE_URL=hdfs://namenode:9000
HDFS_RAW_PATH=/user/bigdata/nyc_taxi/raw
HDFS_PROCESSED_PATH=/user/bigdata/nyc_taxi/processed

# Spark Cluster Configuration
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=3g
SPARK_EXECUTOR_MEMORY=2g

# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=nyc_trips

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=NYC_Taxi_Demand_Forecasting

# Dashboard Server Port
STREAMLIT_SERVER_PORT=8501
